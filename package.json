{
  "build": {
    "appId": "com.vibestudio.app",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "dmg": {
      "window": {
        "height": 420,
        "width": 540
      }
    },
    "files": [
      "electron/**/*",
      "scripts/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "shortcutName": "Vibe Studio",
      "artifactName": "Vibe-Studio-Setup-${version}.${ext}"
    },
    "productName": "Vibe Studio",
    "publish": {
      "owner": "Xsmitylnwza",
      "provider": "github",
      "repo": "spotify-vibe"
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9"
  },
  "description": "Personal scheduled Discord Rich Presence (Vibe Dayline) with a local Presence Studio",
  "devDependencies": {
    "@types/node": "^24.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.js",
  "name": "spotify-vibe",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win -p never",
    "presence:giphy-setup": "node scripts/setup-giphy-key.mjs",
    "presence:poc": "node scripts/discord-presence-poc.mjs",
    "presence:studio": "node scripts/discord-presence-studio.mjs",
    "start": "node scripts/discord-presence-studio.mjs",
    "test": "node --test"
  },
  "type": "module",
  "version": "1.0.7"
}
