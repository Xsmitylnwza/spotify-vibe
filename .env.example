# Optional React/Spotify showcase only.
# Discord Presence keys are managed in Presence Studio → API keys
# or via DISCORD_CLIENT_ID / GIPHY_API_KEY environment variables.

VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=
VITE_SPOTIFY_REFRESH_TOKEN=
# Public directory containing hinata/idle.gif and hinata/poster.png.
# Local Studio works without this; Discord needs publicly hosted artwork.
PRESENCE_ART_BASE_URL=
